# Set the publishable key provisioned for this site in the Attribution System.
VITE_ATTRIBUTION_API_KEY=

# Optional; defaults to the API documentation's local URL.
VITE_ATTRIBUTION_API_URL=http://localhost:5000

# Local Razorpay payment API (the secret key is read only by the backend).
VITE_PAYMENT_API_URL=http://localhost:3001
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PORT=3001
STOREFRONT_ORIGIN=http://localhost:5173
